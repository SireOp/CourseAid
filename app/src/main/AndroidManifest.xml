<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.myCourse"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Task2"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31"
        >
        <receiver
            android:name=".UI.MyReceiver"
            android:enabled="true"
            android:exported="true"></receiver>

        <activity
            android:name=".UI.DetailedCourses"
            android:exported="false"
            android:label="Detailed Courses List "
            android:parentActivityName=".UI.Courses" />
        <activity
            android:name=".UI.DetailedTerms"
            android:exported="false"
            android:label="Detailed Terms"
            android:parentActivityName=".UI.Terms" />
        <activity
            android:name=".UI.Courses"
            android:exported="false"
            android:label="Create A Course"
            android:parentActivityName=".UI.MainActivity" />
        <activity
            android:name=".UI.Terms"
            android:exported="false"
            android:label="Terms"
            android:parentActivityName=".UI.MainActivity" />
        <activity
            android:name=".UI.Assessments"
            android:exported="false"
            android:label="Assessments"
            android:parentActivityName=".UI.MainActivity"/>

        <activity
            android:name=".UI.DetailedAssessments"
            android:exported="false"
            android:label="DetailedAssessments"
            android:parentActivityName=".UI.Assessments"/>



        <activity
            android:name=".UI.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>