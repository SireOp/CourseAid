<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Task2"
        tools:targetApi="31">
        <activity
            android:name=".UI.DetailedCourses"
            android:exported="false"
            android:parentActivityName=".UI.Courses"
            android:label="Detailed Courses List "/>

        <activity
            android:name=".UI.DetailedTerms"
            android:exported="false"
            android:parentActivityName=".UI.Terms"
            android:label="Detailed Terms"/>
        <activity
            android:name=".UI.Courses"
            android:exported="false"
            android:parentActivityName=".UI.MainActivity"
            android:label="Create A Course" />
        <activity
            android:name=".UI.Terms"
            android:exported="false"
            android:parentActivityName=".UI.MainActivity"
            android:label="Terms" />
        <activity
            android:name=".UI.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>