<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".UI.DetailedCourses">



        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">



            <EditText
                android:id="@+id/courseIdEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Course ID"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_marginTop="36dp"/>

            <EditText
                android:id="@+id/courseNameEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Course Name" />

            <EditText
                android:id="@+id/startDateEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter the start date" />

            <EditText
                android:id="@+id/endDateEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter the end date" />


            <EditText
                android:id="@+id/dCoursePhoneEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Instructor Phone" />



            <EditText
                android:id="@+id/dCnotesEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter any notes" />

            <EditText
                android:id="@+id/dCourseInfoEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Course Information" />



            <EditText
                android:id="@+id/dCourseInstructorNameEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Instructor Name" />

            <EditText
                android:id="@+id/dCourseEmailEditTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Instructor Email" />


            <Spinner
                android:id="@+id/courseStatusSpinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />


            <Spinner
                android:id="@+id/courseSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/assessmentRecyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"></androidx.recyclerview.widget.RecyclerView>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detailedCourseRecyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />



            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionBtnDetailedCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:srcCompat="@drawable/baseline_add_24" />
        </LinearLayout>

</ScrollView>
