<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.DetailedTerms">
<ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailedTermsRecyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:visibility="visible"/>


        <EditText
            android:id="@+id/termIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="Term id"
            android:layout_marginTop="36dp"
            />

        <EditText
            android:id="@+id/detailedTermNameEditText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="Term Name"
            />

        <EditText
            android:id="@+id/termEditStartDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="Select Start Date"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:cursorVisible="false"></EditText>
        <EditText
            android:id="@+id/termEditEndDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint="Select End Date"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:cursorVisible="false"></EditText>

        <Spinner
            android:id="@+id/courseSpinner2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />








        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/DetailedTFloatBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="36dp"
            android:clickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollViewTerms"
            app:srcCompat="@drawable/baseline_add_24" />


    </LinearLayout>


    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
